# DealDash Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration (for production)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/dealdash
SUPABASE_DATABASE_URL=postgresql+psycopg2://postgres:password@db.host.supabase.co:5432/postgres?sslmode=require

# Development Settings
NODE_ENV=development
USE_SUPABASE=false
# Set to 'dev' or 'development' to enable SQL statement logging (useful for debugging)
# Defaults to 'production' if not set
ENVIRONMENT=production

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Email Configuration (Gmail SMTP)
# The Gmail email address that will send password reset emails
# This should be the same as SMTP_USERNAME
EMAIL_FROM_ADDRESS=your-email@gmail.com
# Gmail SMTP configuration
SMTP_HOST=smtp.gmail.com
# SMTP port: 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587
# Gmail email address (typically same as EMAIL_FROM_ADDRESS)
SMTP_USERNAME=your-email@gmail.com
# Gmail app password (generate from Google Account settings)
# In production, this will be stored in AWS Secrets Manager as deal-deck-api/gmail-smtp-app-password
SMTP_PASSWORD=your_gmail_app_password_here